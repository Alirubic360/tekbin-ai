    {
      "id": "triage",
      "name": "Triage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -120
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst m = e.message;\nconst links = (m.match(/https?:\\/\\/|www\\./gi) || []).length;\nconst spam = links >= 2 || /\\b(crypto giveaway|casino|loan offer|click here)\\b/i.test(m) || m.replace(/\\s/g, '').length < 2;\nreturn [{ json: { ...e, category: spam ? 'spam' : 'lead' } }];"
      }
    },
