      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst cfg = $('Config').first().json;\n// The booking link is added here, by the workflow, and only for qualified leads. The model never writes links.\nconst reply = e.decision === 'qualified' ? e.reply_text + '\\n' + cfg.booking_text + ' ' + cfg.booking_url : e.reply_text;\nreturn [{ json: { ...e, reply } }];"
