        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_key: $json.event_key, source: $json.source, name: $json.name, contact: $json.contact, qualified: $json.decision === 'qualified', budget_usd: $json.lead.budget_usd, intent: $json.lead.intent, area: $json.lead.area }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "notes": "Bind a credential in n8n. The destination must honour the Idempotency-Key header or enforce a unique constraint on event_key."
    },
