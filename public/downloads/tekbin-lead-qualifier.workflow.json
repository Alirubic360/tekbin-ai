    {
      "id": "normalize",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst str = (v) => (typeof v === 'string' ? v.trim() : '');\nconst source = str(body.source).toLowerCase();\nconst event_id = str(body.event_id);\nconst message = str(body.message);\nconst contact = str(body.contact);\nconst errors = [];\nif (!['whatsapp', 'web'].includes(source)) errors.push('invalid_source');\nif (!event_id || event_id.length > 128) errors.push('invalid_event_id');\nif (!message) errors.push('empty_message');\nif (message.length > 2000) errors.push('message_too_long');\nif (!contact) errors.push('missing_contact');\nif (errors.length) return [{ json: { valid: false, errors } }];\nreturn [{ json: { valid: true, event_key: source + ':' + event_id, source, name: str(body.name).slice(0, 120), contact: contact.slice(0, 120), message } }];"
      }
    },
