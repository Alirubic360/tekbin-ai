    {
      "id": "dedupe",
      "name": "Dedupe check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -60
      ],
      "parameters": {
        "jsCode": "// Read-only check. The event is only marked as processed AFTER the CRM write succeeds,\n// so a failed run can be retried by the sender without being dropped as a duplicate.\n// Note: workflow static data persists only for production (active) executions, not manual tests.\nconst sd = $getWorkflowStaticData('global');\nsd.seen = sd.seen || {};\nconst now = Date.now();\nconst ttl = 7 * 24 * 3600 * 1000;\nfor (const [k, t] of Object.entries(sd.seen)) if (now - t > ttl) delete sd.seen[k];\nconst keys = Object.keys(sd.seen);\nif (keys.length > 5000) keys.sort((a, b) => sd.seen[a] - sd.seen[b]).slice(0, keys.length - 5000).forEach((k) => delete sd.seen[k]);\nconst e = $input.first().json;\nreturn [{ json: { ...e, duplicate: Boolean(sd.seen[e.event_key]) } }];"
      }
    },
